   "metadata": {},
   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Met Office Global 10 km Deterministic NWP – AWS ASDI Demo\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook demonstrates how to use the `site_archive_aws.MOGlobal10km` data accessor\\n\",\n",
    "    \"to read Met Office Global 10 km NWP data directly from AWS S3 and create visualisations.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Dataset\\n\",\n",
    "    \"The Met Office Global Atmospheric High Resolution Model produces operational\\n\",\n",
    "    \"deterministic forecasts at ~10 km horizontal grid spacing, updated every 6 hours.\\n\",\n",
    "    \"Data are publicly available via the [AWS Sustainable Data Initiative](https://registry.opendata.aws/uk-met-office/).\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Requirements\\n\",\n",
    "    \"```\\n\",\n",
    "    \"pip install pyearthtools-archive-aws\\n\",\n",
    "    \"```\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Standard imports\\n\",\n",
    "    \"import warnings\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib.ticker as mticker\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import xarray as xr\\n\",\n",
    "    \"import cartopy.crs as ccrs\\n\",\n",
    "    \"import cartopy.feature as cfeature\\n\",\n",
    "    \"\\n\",\n",
    "    \"# PyEarthTools AWS accessor\\n\",\n",
    "    \"import site_archive_aws\\n\",\n",
    "    \"from site_archive_aws import MOGlobal10km\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"site_archive_aws version: {site_archive_aws.__version__}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Configure the Accessor\\n\",\n",
    "    \"\\n\",\n",
    "    \"We use `anon=True` for anonymous (unauthenticated) access to the public Met Office bucket.\\n\",\n",
    "    \"Remove this flag (or set `anon=False`) if you have AWS credentials configured.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Choose a date and time that has data available.\\n\",\n",
    "    \"# The Global 10km model runs at 00Z, 06Z, 12Z, 18Z.\\n\",\n",
    "    \"QUERY_TIME = \\\"2023-06-01T00:00\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create the accessor for 2-m temperature\\n\",\n",
    "    \"# anon=True → no AWS credentials required for public data\\n\",\n",
    "    \"accessor_2t = MOGlobal10km(\\\"2t\\\", anon=True)\\n\",\n",
    "    \"print(accessor_2t)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Load the Data\\n\",\n",
    "    \"\\n\",\n",
    "    \"Indexing the accessor with a datetime string loads data lazily from S3.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load 2-m temperature for the chosen time\\n\",\n",
    "    \"ds_2t = accessor_2t[QUERY_TIME]\\n\",\n",
    "    \"print(ds_2t)\\n\",\n",
    "    \"print(\\\"\\\\nVariables:\\\", list(ds_2t.data_vars))\\n\",\n",
    "    \"print(\\\"Coordinates:\\\", list(ds_2t.coords))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Global Map of 2-m Temperature\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Extract the temperature field (convert K → °C for readability)\\n\",\n",
    "    \"# xarray's .squeeze() removes any size-1 dimensions (e.g. single time step)\\n\",\n",
    "    \"t2m = ds_2t[\\\"air_temperature\\\"].squeeze() - 273.15  # K → °C\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(\\n\",\n",
    "    \"    figsize=(14, 7),\\n\",\n",
    "    \"    subplot_kw={\\\"projection\\\": ccrs.PlateCarree()},\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot the data as a filled contour map\\n\",\n",
    "    \"im = ax.contourf(\\n\",\n",
    "    \"    t2m[\\\"longitude\\\"],\\n\",\n",
    "    \"    t2m[\\\"latitude\\\"],\\n\",\n",
    "    \"    t2m.values,\\n\",\n",
    "    \"    levels=np.linspace(-50, 45, 40),\\n\",\n",
    "    \"    cmap=\\\"RdBu_r\\\",\\n\",\n",
    "    \"    transform=ccrs.PlateCarree(),\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add geographic features\\n\",\n",
    "    \"ax.add_feature(cfeature.COASTLINE, linewidth=0.5)\\n\",\n",
    "    \"ax.add_feature(cfeature.BORDERS, linewidth=0.3, linestyle=\\\"--\\\")\\n\",\n",
    "    \"ax.gridlines(draw_labels=True, linewidth=0.3, color=\\\"grey\\\", alpha=0.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Colourbar and labels\\n\",\n",
    "    \"plt.colorbar(im, ax=ax, label=\\\"2-m Temperature (°C)\\\", shrink=0.7, pad=0.02)\\n\",\n",
    "    \"ax.set_title(\\n\",\n",
    "    \"    f\\\"Met Office Global 10 km – 2-m Temperature\\\\n{QUERY_TIME} (UTC)\\\",\\n\",\n",
    "    \"    fontsize=14,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig(\\\"global_10km_2t.png\\\", dpi=150, bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"print(\\\"Figure saved to global_10km_2t.png\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Load Multiple Variables\\n\",\n",
    "    \"\\n\",\n",
    "    \"Load 10-metre wind components and compute wind speed.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load both wind components in one call\\n\",\n",
    "    \"accessor_wind = MOGlobal10km([\\\"10u\\\", \\\"10v\\\"], anon=True)\\n\",\n",
    "    \"ds_wind = accessor_wind[QUERY_TIME]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Compute wind speed\\n\",\n",
    "    \"u = ds_wind[\\\"x_wind\\\"].squeeze()\\n\",\n",
    "    \"v = ds_wind[\\\"y_wind\\\"].squeeze()\\n\",\n",
    "    \"speed = np.sqrt(u**2 + v**2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Wind speed statistics:\\\")\\n\",\n",
    "    \"print(f\\\"  Min:  {float(speed.min()):.1f} m/s\\\")\\n\",\n",
    "    \"print(f\\\"  Max:  {float(speed.max()):.1f} m/s\\\")\\n\",\n",
    "    \"print(f\\\"  Mean: {float(speed.mean()):.1f} m/s\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"fig, ax = plt.subplots(\\n\",\n",
    "    \"    figsize=(14, 7),\\n\",\n",
    "    \"    subplot_kw={\\\"projection\\\": ccrs.PlateCarree()},\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"im = ax.contourf(\\n\",\n",
    "    \"    speed[\\\"longitude\\\"],\\n\",\n",
    "    \"    speed[\\\"latitude\\\"],\\n\",\n",
    "    \"    speed.values,\\n\",\n",
    "    \"    levels=np.linspace(0, 30, 31),\\n\",\n",
    "    \"    cmap=\\\"YlOrRd\\\",\\n\",\n",
    "    \"    transform=ccrs.PlateCarree(),\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Subsample for wind barbs to avoid over-plotting\\n\",\n",
    "    \"step = max(1, len(speed.latitude) // 30)\\n\",\n",
    "    \"lons = speed[\\\"longitude\\\"].values[::step]\\n\",\n",
    "    \"lats = speed[\\\"latitude\\\"].values[::step]\\n\",\n",
    "    \"U = u.values[::step, ::step]\\n\",\n",
    "    \"V = v.values[::step, ::step]\\n\",\n",
    "    \"ax.barbs(\\n\",\n",
    "    \"    lons, lats, U, V,\\n\",\n",
    "    \"    length=4, linewidth=0.5, color=\\\"k\\\", alpha=0.5,\\n\",\n",
    "    \"    transform=ccrs.PlateCarree(),\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.add_feature(cfeature.COASTLINE, linewidth=0.5)\\n\",\n",
    "    \"plt.colorbar(im, ax=ax, label=\\\"10-m Wind Speed (m/s)\\\", shrink=0.7, pad=0.02)\\n\",\n",
    "    \"ax.set_title(\\n\",\n",
    "    \"    f\\\"Met Office Global 10 km – 10-m Wind Speed\\\\n{QUERY_TIME} (UTC)\\\",\\n\",\n",
    "    \"    fontsize=14,\\n\",\n",
    "    \")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig(\\\"global_10km_wind.png\\\", dpi=150, bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"print(\\\"Figure saved to global_10km_wind.png\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"In this notebook we:\\n\",\n",
    "    \"1. Created a `MOGlobal10km` accessor with anonymous S3 access.\\n\",\n",
    "    \"2. Loaded 2-m temperature and produced a global filled-contour map.\\n\",\n",
    "    \"3. Loaded 10-m wind components, computed wind speed, and plotted a wind barb map.\\n\",\n",
    "    \"\\n\",\n",
    "    \"See the companion script `scripts/demo_mo_global_10km.py` for the equivalent\\n\",\n",
    "    \"command-line version.\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
