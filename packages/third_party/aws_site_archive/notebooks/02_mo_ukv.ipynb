 "cells": [
  {
   "metadata": {},
   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Met Office UKV Model – AWS ASDI Demo\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook demonstrates how to use the `site_archive_aws.MOUKV` data accessor\\n\",\n",
    "    \"to read Met Office UKV (UK Variable-Resolution Model) data from AWS S3.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Dataset\\n\",\n",
    "    \"The UKV is the Met Office's operational high-resolution deterministic model\\n\",\n",
    "    \"covering the United Kingdom at approximately 1.5 km grid spacing.\\n\",\n",
    "    \"It runs every hour and provides forecasts out to 36 hours.\\n\",\n",
    "    \"\\n\",\n",
    "    \"The UKV uses a rotated-pole coordinate system; the accessor transparently\\n\",\n",
    "    \"renames `grid_latitude`/`grid_longitude` to standard `latitude`/`longitude`.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Requirements\\n\",\n",
    "    \"```\\n\",\n",
    "    \"pip install pyearthtools-archive-aws\\n\",\n",
    "    \"```\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import xarray as xr\\n\",\n",
    "    \"import cartopy.crs as ccrs\\n\",\n",
    "    \"import cartopy.feature as cfeature\\n\",\n",
    "    \"\\n\",\n",
    "    \"import site_archive_aws\\n\",\n",
    "    \"from site_archive_aws import MOUKV\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"site_archive_aws version: {site_archive_aws.__version__}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Configure the Accessor\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# The UKV runs every hour; choose any hour\\n\",\n",
    "    \"QUERY_TIME = \\\"2023-06-01T06:00\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create accessor for 2-m temperature\\n\",\n",
    "    \"accessor = MOUKV(\\\"2t\\\", anon=True)\\n\",\n",
    "    \"print(accessor)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Load 2-m Temperature\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"ds = accessor[QUERY_TIME]\\n\",\n",
    "    \"print(ds)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Convert K → °C\\n\",\n",
    "    \"t2m = ds[\\\"air_temperature\\\"].squeeze() - 273.15\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Map of 2-m Temperature over the UK\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"fig, ax = plt.subplots(\\n\",\n",
    "    \"    figsize=(8, 10),\\n\",\n",
    "    \"    subplot_kw={\\\"projection\\\": ccrs.PlateCarree()},\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"im = ax.contourf(\\n\",\n",
    "    \"    t2m[\\\"longitude\\\"],\\n\",\n",
    "    \"    t2m[\\\"latitude\\\"],\\n\",\n",
    "    \"    t2m.values,\\n\",\n",
    "    \"    levels=np.linspace(-5, 30, 36),\\n\",\n",
    "    \"    cmap=\\\"RdBu_r\\\",\\n\",\n",
    "    \"    transform=ccrs.PlateCarree(),\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.add_feature(cfeature.COASTLINE, linewidth=0.8)\\n\",\n",
    "    \"ax.add_feature(cfeature.BORDERS, linewidth=0.5)\\n\",\n",
    "    \"ax.add_feature(cfeature.RIVERS.with_scale(\\\"10m\\\"), linewidth=0.3, alpha=0.5)\\n\",\n",
    "    \"ax.gridlines(draw_labels=True, linewidth=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Zoom to UK\\n\",\n",
    "    \"ax.set_extent([-10, 3, 49, 61], crs=ccrs.PlateCarree())\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.colorbar(im, ax=ax, label=\\\"2-m Temperature (°C)\\\", shrink=0.7)\\n\",\n",
    "    \"ax.set_title(\\n\",\n",
    "    \"    f\\\"Met Office UKV – 2-m Temperature\\\\n{QUERY_TIME} (UTC)\\\",\\n\",\n",
    "    \"    fontsize=13,\\n\",\n",
    "    \")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig(\\\"ukv_2t.png\\\", dpi=150, bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"print(\\\"Figure saved to ukv_2t.png\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Total Precipitation\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load total precipitation\\n\",\n",
    "    \"acc_precip = MOUKV(\\\"tp\\\", anon=True)\\n\",\n",
    "    \"ds_precip = acc_precip[QUERY_TIME]\\n\",\n",
    "    \"precip = ds_precip[\\\"stratiform_rainfall_amount\\\"].squeeze()  # kg/m² ≈ mm\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(\\n\",\n",
    "    \"    figsize=(8, 10),\\n\",\n",
    "    \"    subplot_kw={\\\"projection\\\": ccrs.PlateCarree()},\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"im = ax.contourf(\\n\",\n",
    "    \"    precip[\\\"longitude\\\"],\\n\",\n",
    "    \"    precip[\\\"latitude\\\"],\\n\",\n",
    "    \"    precip.values,\\n\",\n",
    "    \"    levels=[0, 0.1, 0.5, 1, 2, 4, 8, 16, 32, 64],\\n\",\n",
    "    \"    cmap=\\\"Blues\\\",\\n\",\n",
    "    \"    transform=ccrs.PlateCarree(),\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.add_feature(cfeature.COASTLINE, linewidth=0.8)\\n\",\n",
    "    \"ax.set_extent([-10, 3, 49, 61], crs=ccrs.PlateCarree())\\n\",\n",
    "    \"plt.colorbar(im, ax=ax, label=\\\"Total Precipitation (mm)\\\", shrink=0.7)\\n\",\n",
    "    \"ax.set_title(\\n\",\n",
    "    \"    f\\\"Met Office UKV – Total Precipitation\\\\n{QUERY_TIME} (UTC)\\\",\\n\",\n",
    "    \"    fontsize=13,\\n\",\n",
    "    \")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig(\\\"ukv_precip.png\\\", dpi=150, bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"print(\\\"Figure saved to ukv_precip.png\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"In this notebook we:\\n\",\n",
    "    \"1. Loaded UKV 2-m temperature and produced a UK regional map.\\n\",\n",
    "    \"2. Loaded UKV total precipitation and visualised it.\\n\",\n",
    "    \"\\n\",\n",
    "    \"See `scripts/demo_mo_ukv.py` for the command-line equivalent.\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
