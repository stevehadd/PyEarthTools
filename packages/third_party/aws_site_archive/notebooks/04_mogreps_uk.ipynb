   "metadata": {},
   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Met Office MOGREPS-UK (UK Regional Ensemble) – AWS ASDI Demo\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook demonstrates how to use the `site_archive_aws.MOGREPSUK` accessor\\n\",\n",
    "    \"to read and visualise Met Office MOGREPS-UK ensemble data from AWS S3.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Dataset\\n\",\n",
    "    \"MOGREPS-UK is the Met Office's operational UK-domain ensemble prediction system.\\n\",\n",
    "    \"It produces 18-member ensemble forecasts at ~2.2 km grid spacing out to 54 hours,\\n\",\n",
    "    \"with output every 3 hours.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Requirements\\n\",\n",
    "    \"```\\n\",\n",
    "    \"pip install pyearthtools-archive-aws\\n\",\n",
    "    \"```\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import xarray as xr\\n\",\n",
    "    \"import cartopy.crs as ccrs\\n\",\n",
    "    \"import cartopy.feature as cfeature\\n\",\n",
    "    \"\\n\",\n",
    "    \"import site_archive_aws\\n\",\n",
    "    \"from site_archive_aws import MOGREPSUK\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"site_archive_aws version: {site_archive_aws.__version__}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Configure the Accessor\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"QUERY_TIME = \\\"2023-06-01T03:00\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load a subset of members for speed in this demo\\n\",\n",
    "    \"accessor = MOGREPSUK(\\\"2t\\\", members=list(range(6)), anon=True)\\n\",\n",
    "    \"print(accessor)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Load Ensemble Data\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"ds = accessor[QUERY_TIME]\\n\",\n",
    "    \"print(ds)\\n\",\n",
    "    \"print(\\\"Realization values:\\\", ds[\\\"realization\\\"].values)\\n\",\n",
    "    \"\\n\",\n",
    "    \"t2m = ds[\\\"air_temperature\\\"].squeeze(dim=\\\"time\\\", drop=True) - 273.15\\n\",\n",
    "    \"print(\\\"Shape (realization, lat, lon):\\\", t2m.shape)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Ensemble-Mean 2-m Temperature over the UK\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"ens_mean = t2m.mean(\\\"realization\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(\\n\",\n",
    "    \"    figsize=(8, 10),\\n\",\n",
    "    \"    subplot_kw={\\\"projection\\\": ccrs.PlateCarree()},\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"im = ax.contourf(\\n\",\n",
    "    \"    ens_mean[\\\"longitude\\\"],\\n\",\n",
    "    \"    ens_mean[\\\"latitude\\\"],\\n\",\n",
    "    \"    ens_mean.values,\\n\",\n",
    "    \"    levels=np.linspace(-5, 30, 36),\\n\",\n",
    "    \"    cmap=\\\"RdBu_r\\\",\\n\",\n",
    "    \"    transform=ccrs.PlateCarree(),\\n\",\n",
    "    \"    extend=\\\"both\\\",\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.add_feature(cfeature.COASTLINE, linewidth=0.8)\\n\",\n",
    "    \"ax.add_feature(cfeature.BORDERS, linewidth=0.5)\\n\",\n",
    "    \"ax.set_extent([-10, 3, 49, 61], crs=ccrs.PlateCarree())\\n\",\n",
    "    \"ax.gridlines(draw_labels=True, linewidth=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.colorbar(im, ax=ax, label=\\\"2-m Temperature (°C)\\\", shrink=0.7)\\n\",\n",
    "    \"ax.set_title(\\n\",\n",
    "    \"    f\\\"MOGREPS-UK – Ensemble Mean 2-m Temperature\\\\n{QUERY_TIME} (UTC)\\\",\\n\",\n",
    "    \"    fontsize=13,\\n\",\n",
    "    \")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig(\\\"mogreps_uk_2t_mean.png\\\", dpi=150, bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"print(\\\"Figure saved to mogreps_uk_2t_mean.png\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Probability of Temperature > 20 °C\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"threshold = 20.0  # °C\\n\",\n",
    "    \"prob_warm = (t2m > threshold).mean(\\\"realization\\\") * 100  # percentage\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(\\n\",\n",
    "    \"    figsize=(8, 10),\\n\",\n",
    "    \"    subplot_kw={\\\"projection\\\": ccrs.PlateCarree()},\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"im = ax.contourf(\\n\",\n",
    "    \"    prob_warm[\\\"longitude\\\"],\\n\",\n",
    "    \"    prob_warm[\\\"latitude\\\"],\\n\",\n",
    "    \"    prob_warm.values,\\n\",\n",
    "    \"    levels=np.arange(0, 110, 10),\\n\",\n",
    "    \"    cmap=\\\"YlOrRd\\\",\\n\",\n",
    "    \"    transform=ccrs.PlateCarree(),\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.add_feature(cfeature.COASTLINE, linewidth=0.8)\\n\",\n",
    "    \"ax.set_extent([-10, 3, 49, 61], crs=ccrs.PlateCarree())\\n\",\n",
    "    \"ax.gridlines(draw_labels=True, linewidth=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.colorbar(im, ax=ax, label=f\\\"P(T2m > {threshold} °C) [%]\\\", shrink=0.7)\\n\",\n",
    "    \"ax.set_title(\\n\",\n",
    "    \"    f\\\"MOGREPS-UK – P(2-m T > {threshold} °C)\\\\n{QUERY_TIME} (UTC)\\\",\\n\",\n",
    "    \"    fontsize=13,\\n\",\n",
    "    \")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig(\\\"mogreps_uk_prob_warm.png\\\", dpi=150, bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"print(\\\"Figure saved to mogreps_uk_prob_warm.png\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"In this notebook we:\\n\",\n",
    "    \"1. Loaded MOGREPS-UK 2-m temperature for 6 ensemble members.\\n\",\n",
    "    \"2. Plotted the ensemble-mean temperature over the UK.\\n\",\n",
    "    \"3. Computed and displayed the probability of temperatures exceeding 20 °C.\\n\",\n",
    "    \"\\n\",\n",
    "    \"See `scripts/demo_mogreps_uk.py` for the command-line equivalent.\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
